# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# .env asla commit edilmez (.gitignore'da).

# PostgreSQL + pgvector
POSTGRES_USER=btu_asistan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=btu_asistan
# DocAssistant 5432'yi kullandığı için bu proje 5433'te.
POSTGRES_PORT=5433
# API'nin bağlandığı kısıtlı kullanıcının (btu_asistan_app) parolası.
# POSTGRES_USER tabloların sahibidir ve yalnızca migration'lar için kullanılır.
APP_DB_PASSWORD=change-me-app

# API'nin oturum anahtarı; yalnızca sunucuda (API container'ı) kullanılır. Geliştirmede API
# makinede çalıştığı için anahtar user-secrets'tadır, burası boş kalabilir.
# En az 32 karakter; üretmek için (her işletim sisteminde aynı):
#   docker run --rm alpine sh -c "head -c 48 /dev/urandom | base64"
JWT_SIGNING_KEY=

# Ön yüz (Caddy; yalnızca sunucuda). PLANNING Faz 6, E2–E4; docs/kurulum.md.
# Sitenin adresi. Okulun ters vekili HTTPS'i yapıyorsa http:// ile başlar.
SITE_ADDRESS=localhost
# auto: Let's Encrypt (adres internetten erişilebilmeli) · files: okulun sertifikası ./certs
# altında (TLS_CERT_FILE, TLS_KEY_FILE) · off: okulun ters vekili HTTPS yapıyor ·
# internal: tek makinede deneme (tarayıcı sertifikaya güvenmez)
TLS_MODE=internal
TLS_CERT_FILE=cert.pem
TLS_KEY_FILE=key.pem
# Sohbeti iframe ile gösterebilecek siteler, boşlukla ayrılmış (ör. https://www.btu.edu.tr https://imep.btu.edu.tr).
# 'none' hiçbir siteye izin vermez.
WIDGET_ALLOWED_PARENTS='none'
# TLS_MODE=off iken okulun ters vekilinin adresi (ör. 10.0.5.20/32); öğrenci adresine yalnızca ondan gelince güvenilir.
TRUSTED_PROXIES=127.0.0.1/32
# Sunucunun dışarı açılan portları.
HTTP_PORT=80
HTTPS_PORT=443

# Gece yedeği (yalnızca sunucuda): ./backups klasörüne, her gün bu saatte (TZ), bu kadar gün tutulur.
# Yedekte öğrenci soruları var (KVKK): klasöre yalnızca BT erişmeli, sunucu dışına kopyalamak BT'nin işi.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
TZ=Europe/Istanbul

# Python ai-service (yalnızca .NET API çağırır)
AI_SERVICE_PORT=8001
# API'deki Embedding:Model ile aynı olmalı; API başka modelin vektörlerini reddeder.
EMBEDDING_MODEL=BAAI/bge-m3
# Container'ın bellek sınırı; bge-m3 yüklendiğinde yaklaşık 1 GB kullanır.
AI_SERVICE_MEMORY=6g
# Model bir kez indirildikten sonra 1 yapılırsa servis Hugging Face'e hiç bağlanmadan açılır
# (internete çıkışı olmayan sunucular için).
HF_HUB_OFFLINE=0
# Reranker (isteğe bağlı): 1 yapılırsa AI servisi bge-reranker-v2-m3'ü de yükler
# (yaklaşık 2,3 GB indirme ve bellek). API'de Reranker:Enabled da açılmalıdır.
RERANKER_ENABLED=0
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Sohbet modeli (Faz 4). Anahtar yalnızca AI servisine verilir, API'ye hiç girmez.
# Geliştirmede ücretsiz katman anahtarı kullanılabilir; CANLIDA YALNIZCA ÜCRETLİ ANAHTAR:
# ücretsiz katmanda Google gönderilen metinleri ürünlerini geliştirmek için kullanabilir.
# Boş bırakılırsa sohbet çalışmaz, arama ve belge işleme çalışır.
GEMINI_API_KEY=
# Anahtarla erişilebilen modellerden biri (README: "Gemini modelini seçmek"); 2026-11-18 denemesiyle seçildi.
GEMINI_MODEL=gemini-3.5-flash-lite

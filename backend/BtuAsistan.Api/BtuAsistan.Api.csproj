<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>54e2c875-effc-4123-b92c-d3b7f589431c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The Design package is private, so it does not carry the EF Core version to projects that
         reference this one (the evaluation tool); without this explicit reference they resolve an
         older version and do not build. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
  </ItemGroup>

  <!-- Unit tests reach a few internal helpers (e.g. the ID number check) directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BtuAsistan.Api.Tests" />
  </ItemGroup>

</Project>
